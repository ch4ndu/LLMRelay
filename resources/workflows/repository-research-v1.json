{
  "schema": 1,
  "family": "single_agent",
  "id": "llmrelay-repository-research-v1",
  "version": "repository-research-v1",
  "description": "Read an isolated repository and deliver an authenticated research report for human acceptance.",
  "evaluator": {"id": "llmrelay-single-agent-evaluator", "revision": 1},
  "steps": ["agent_execution", "structured_result", "unchanged_candidate", "human_decision"],
